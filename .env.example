# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# Required. Your Claude subscription token: run `claude setup-token` on your machine and paste the
# value here on one line.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Where the company may reach. open (the default) is the public internet except the sites
# in door/shut.txt. allowlist is the model, npm and PyPI only. After changing it, run
# `docker compose up -d door`.
# DOOR_MODE=open
